{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "z-skillos:frontend-handoff:page-data-contract:v1",
  "title": "Z-SkillOS Frontend Handoff Page Data Contract",
  "description": "11 pages with data sources, API endpoints, all UI states, and permission matrices.",
  "version": "v0.1.0-rc",
  "seal": "A1_CONTRACT_FREEZE",
  "pages": [
    {
      "page_id": "home_dashboard",
      "route": "/",
      "title": "Home Dashboard",
      "description": "System overview, gate status indicators, recent activity feed",
      "data_sources": ["dashboard_summary"],
      "api_endpoints": ["/api/dashboard/summary"],
      "required_permissions": [],
      "forbidden_actions": [
        "start_pipeline",
        "stop_pipeline",
        "enable_skill",
        "disable_skill",
        "modify_config"
      ],
      "states": {
        "loading": {
          "description": "Dashboard data is being fetched from /api/dashboard/summary",
          "ui": "loading_spinner",
          "timeout_ms": 10000
        },
        "empty": {
          "description": "No dashboard data returned (first run, empty DB)",
          "ui": "empty_state",
          "message": "No dashboard data available yet. System may be initializing."
        },
        "error": {
          "description": "API returned an error",
          "ui": "error_card",
          "retry": true,
          "retry_endpoint": "/api/dashboard/summary"
        },
        "degraded": {
          "description": "Some components are degraded but partial data available",
          "ui": "degraded_badge",
          "degraded_components": ["gate_state", "activity_feed"],
          "remaining_components": ["system_health", "component_status"]
        },
        "blocked": {
          "description": "Dashboard access blocked due to permissions",
          "ui": "blocked_overlay",
          "reason": "Dashboard is always accessible; this state is a safety boundary placeholder"
        },
        "success": {
          "description": "Dashboard loaded successfully with all components",
          "ui": "success_indicator",
          "data_schema": {"$ref": "dashboard_contract.json#/dashboard_summary"}
        }
      },
      "fixture_payload": {
        "system_health": "ok",
        "gate_summary": {"passed": 8, "failed": 0, "pending": 3, "blocked": 0},
        "component_status": {
          "factor_library": "ok",
          "composition_graph": "ok",
          "research_report": "disabled_default",
          "z9_review": "disabled_default",
          "evidence_chain": "ok",
          "run_state": "ok",
          "gate_state": "ok",
          "audit_trail": "ok"
        },
        "recent_activity": []
      }
    },
    {
      "page_id": "capabilities",
      "route": "/capabilities",
      "title": "Capability Invocation OS",
      "description": "Skill catalog viewer showing invocation status for all registered skills",
      "data_sources": ["capability_list"],
      "api_endpoints": ["/api/capabilities"],
      "required_permissions": [],
      "forbidden_actions": [
        "invoke_skill",
        "enable_skill",
        "disable_skill",
        "configure_skill",
        "promote_skill"
      ],
      "states": {
        "loading": {
          "description": "Capability catalog is being fetched",
          "ui": "loading_spinner",
          "timeout_ms": 10000
        },
        "empty": {
          "description": "No capabilities registered",
          "ui": "empty_state",
          "message": "No capabilities registered in the system."
        },
        "error": {
          "description": "Failed to load capability list",
          "ui": "error_card",
          "retry": true,
          "retry_endpoint": "/api/capabilities"
        },
        "degraded": {
          "description": "Partial capability data (some skills unresponsive)",
          "ui": "degraded_badge",
          "degraded_components": ["skill_detail_panel"],
          "remaining_components": ["skill_list"]
        },
        "blocked": {
          "description": "Access blocked",
          "ui": "blocked_overlay",
          "reason": "Capabilities page is always accessible; blocked state is a safety placeholder"
        },
        "success": {
          "description": "Capability catalog loaded successfully",
          "ui": "success_indicator",
          "data_schema": {
            "type": "object",
            "required": ["capabilities", "total_count", "enabled_count"],
            "properties": {
              "capabilities": {"type": "array"},
              "total_count": {"type": "integer"},
              "enabled_count": {"type": "integer", "const": 0},
              "readonly": {"const": true}
            }
          }
        }
      },
      "fixture_payload": {
        "capabilities": [],
        "total_count": 0,
        "enabled_count": 0,
        "readonly": true
      }
    },
