{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "additionalProperties": false,
 "required": ["factor_id","blocked_application_modes","blocked_outputs","blocked_downstream_consumers","alpha_claim_allowed","production","broker_runtime","real_trade"],
 "allOf": [
  {"properties": {"blocked_application_modes": {"contains": {"const": "ALPHA_SIGNAL"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "PORTFOLIO_WEIGHT"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "ORDER_SIGNAL"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "PAPER_TRADING"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "BROKER_RUNTIME"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "REAL_TRADE"}}}},
  {"properties": {"blocked_application_modes": {"contains": {"const": "PRODUCTION"}}}},
  {"properties": {"blocked_outputs": {"contains": {"const": "buy_signal"}}}},
  {"properties": {"blocked_outputs": {"contains": {"const": "sell_signal"}}}},
  {"properties": {"blocked_outputs": {"contains": {"const": "position_weight"}}}},
  {"properties": {"blocked_outputs": {"contains": {"const": "expected_return_claim"}}}},
  {"properties": {"blocked_outputs": {"contains": {"const": "alpha_claim"}}}},
  {"properties": {"blocked_downstream_consumers": {"contains": {"const": "Z8_EXECUTION_RUNTIME"}}}},
  {"properties": {"blocked_downstream_consumers": {"contains": {"const": "V3_TRADE_SANDBOX"}}}},
  {"properties": {"blocked_downstream_consumers": {"contains": {"const": "BROKER"}}}},
  {"properties": {"blocked_downstream_consumers": {"contains": {"const": "REAL_TRADE"}}}}
 ],
 "properties": {
  "pipeline_signature": {"type": "string"},
  "factor_id": {"type": "string"},
  "factor_name": {"type": "string"},
  "allowed_application_modes": {"type": "array", "items": {"type": "string", "enum": ["REGISTRY_READ","EVIDENCE_READ","VALIDATION_SUMMARY","GUARDRAIL_SUMMARY","CANDIDATE_MONITOR","RESEARCH_CONTEXT","SCORING_CONTEXT_DRY_PLAN","COMPOSITION_GRAPH_DRY_PLAN"]}},
  "blocked_application_modes": {"type": "array", "items": {"type": "string"}},
  "allowed_outputs": {"type": "array", "items": {"type": "string"}},
  "blocked_outputs": {"type": "array", "items": {"type": "string"}},
  "blocked_downstream_consumers": {"type": "array", "items": {"type": "string"}},
  "alpha_claim_allowed": {"type": "boolean", "const": false},
  "production": {"type": "string", "const": "BLOCKED"},
  "broker_runtime": {"type": "string", "const": "BLOCKED"},
  "real_trade": {"type": "string", "const": "BLOCKED"}
 }
}
